Option "display" "string file" ["$<TARGET_FILE_NAME:file_dspy>"]
Option "display" "string framebuffer" ["$<TARGET_FILE_NAME:piqsl_dspy>"]
Option "display" "string zfile" ["$<TARGET_FILE_NAME:file_dspy>"]
Option "display" "string zframebuffer" ["$<TARGET_FILE_NAME:piqsl_dspy>"]
Option "display" "string shadow" ["$<TARGET_FILE_NAME:file_dspy>"]
Option "display" "string tiff" ["$<TARGET_FILE_NAME:file_dspy>"]
Option "display" "string xpm" ["$<TARGET_FILE_NAME:xpm_dspy>"]
Option "display" "string exr" ["$<TARGET_FILE_NAME:exr_dspy>"]
Option "display" "string bmp" ["$<TARGET_FILE_NAME:bmp_dspy>"]
Option "display" "string debugdd" ["debugdd"]
Option "display" "string piqsl" ["$<TARGET_FILE_NAME:piqsl_dspy>"]

Option "defaultsearchpath" "string shader" ["/usr/local/share/aqsis/shaders/displacement:/usr/local/share/aqsis/shaders/imager:/usr/local/share/aqsis/shaders/light:/usr/local/share/aqsis/shaders/surface:/usr/local/share/aqsis/shaders/volume"]
Option "defaultsearchpath" "string archive" ["/usr/local"]
Option "defaultsearchpath" "string texture" ["/usr/local"]
Option "defaultsearchpath" "string display" ["/usr/local/lib/aqsis"]
Option "defaultsearchpath" "string procedural" ["/usr/local/lib/aqsis"]
Option "defaultsearchpath" "string resource" ["/usr/local"]

Option "searchpath" "string shader" [".:@:"]
Option "searchpath" "string archive" [".:@:"]
Option "searchpath" "string texture" [".:@:"]
Option "searchpath" "string display" [".:@:"]
Option "searchpath" "string procedural" [".:@:%MASSIVE_HOME%/bin:"]
Option "searchpath" "string resource" [".:@:"]
