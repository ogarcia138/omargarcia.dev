imager
AQSIS_V 2


segment Data

USES 393472

param uniform  color earth
param uniform  color skycolor
varying  float lenx
varying  float leny
varying  float resolution[3]


segment Init
	pushif 0.100000001
	pushif 0.400000006
	pushif 0
	settc
	pop earth
	pushif 1
	pushif 0.600000024
	pushif 0.600000024
	settc
	pop skycolor


segment Code
	pushis "Format"
	option resolution
	drop
	pushif 0
	ipushv resolution
	pushv P
	xcomp
	divff
	pop lenx
	pushif 1
	ipushv resolution
	pushv P
	ycomp
	divff
	pop leny
	pushv leny
	pushv earth
	pushv skycolor
	cmix
	pushv Oi
	pushif 1
	subfc
	mulcc
	pushv Ci
	addcc
	pop Ci
	pushif 1
	setfc
	pop Oi
