# Hey! This file tells the computer how to draw a wavy shape using a bunch of donuts (called tori) and a ball in the middle.

# Set up how big the picture is
# We up the image size and format
Format 640 480 1

# Now up the output image
Display "toruswave.jpg" "file" "rgb"
PixelSamples 4 4
# We up the image size and format
Format 640 480 1

# Now up the output image
Display "toruswave.jpg" "file" "rgb"
PixelSamples 4 4
Exposure 1.1 2.3

# And then also we have t set up the camera
Projection "perspective" "fov" [45]
Translate 0 0 5  # Move the camera back to see the scene

# Alec says: and begin the scene!
WorldBegin

    # Add lights so we can see the shape!
    LightSource "ambientlight" 1 "intensity" [0.07]
    LightSource "distantlight" 2 "intensity" [3.0] "from" [0 0 5] "to" [0 0 0]

    # Make the surface shiny like plastic
    Surface "plastic"

    # Now we start making the tori. There are 8 of them like ripples in water.
    AttributeBegin
        Color [0 0.4 0.2]  # This is a nice greenish color
        Rotate -90 1 0 0   # Turn it so it stands up

        # Each one goes higher and gets a little bigger
        TransformBegin
            Translate 0 0 0.15
            Torus 0.1 0.6 0 360 360
        TransformEnd

        TransformBegin
            Translate 0 0 0.3
            Torus 0.1 0.7 0 360 360
        TransformEnd

        TransformBegin
            Translate 0 0 0.45
            Torus 0.1 0.8 0 360 360
        TransformEnd

        TransformBegin
            Translate 0 0 0.6
            Torus 0.1 0.9 0 360 360
        TransformEnd

        TransformBegin
            Translate 0 0 0.75
            Torus 0.1 1.0 0 360 360
        TransformEnd

        TransformBegin
            Translate 0 0 0.9
            Torus 0.1 1.1 0 360 360
        TransformEnd

        TransformBegin
            Translate 0 0 1.05
            Torus 0.1 1.2 0 360 360
        TransformEnd

        TransformBegin
            Translate 0 0 1.2
            Torus 0.1 1.3 0 360 360
        TransformEnd
    AttributeEnd

    # Put a ball in the middle to cap the wave!
    AttributeBegin
        Color [0 0.6 0.3]  # Brighter green for the center
        Translate 0 0 0.075
        Sphere 0.15 -0.15 0.15 360
    AttributeEnd

# All done!
WorldEnd
